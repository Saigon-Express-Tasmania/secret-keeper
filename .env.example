# Which storage backend to use: r2 | s3 | supabase | gdrive
VITE_STORAGE_PROVIDER=r2

# Extra Argon2 pepper (long random secret). Required for encrypt/decrypt.
# Not stored in the vault blob — keep this stable or existing blobs won't unlock.
VITE_VAULT_SALT_KEY=

# Login-time copies of the live vault blob on the same bucket.
# Object key comes from the Gate vault name (auto-suffixed with .enc).
# Names: {prefix}{objectKey}-{yyyyMMddTHHmmssZ}  e.g. bak-vault.enc-20260906T080000Z
# Prefix must not match the live object key. 0 hours disables backups.
VITE_VAULT_BACKUP_PREFIX=bak-
VITE_VAULT_BACKUP_INTERVAL_HOURS=8
VITE_VAULT_BACKUP_RETENTION_DAYS=7

# --- Cloudflare R2 (S3-compatible) ---
VITE_R2_ACCOUNT_ID=
VITE_R2_ACCESS_KEY_ID=
VITE_R2_SECRET_ACCESS_KEY=
VITE_R2_BUCKET=
# Optional. Only used if it contains r2.cloudflarestorage.com (S3 API host).
# Public CDN URLs are ignored; the adapter uses https://<account_id>.r2.cloudflarestorage.com
VITE_R2_ENDPOINT=

# --- AWS S3 ---
VITE_S3_REGION=
VITE_S3_ACCESS_KEY_ID=
VITE_S3_SECRET_ACCESS_KEY=
VITE_S3_BUCKET=

# --- Supabase Storage ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_BUCKET=

# --- Google Drive ---
VITE_GDRIVE_CLIENT_ID=
VITE_GDRIVE_CLIENT_SECRET=
VITE_GDRIVE_REFRESH_TOKEN=
VITE_GDRIVE_FOLDER_ID=

# NOTE: Any VITE_* variable is embedded in the client bundle.
# Prefer Netlify Functions for real storage credentials so secrets
# never ship to the browser. See docs/security.md and docs/deployment.md.
