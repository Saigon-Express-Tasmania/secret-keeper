# Server settings for the vault Function (netlify/functions/vault.mts).
#
# None of these use the VITE_ prefix: Vite inlines VITE_* values into the
# public JS bundle, and the build now refuses to run if any VITE_ variable is
# set. In Netlify, add these under Site settings → Environment variables with
# scope "Functions" and context "Production" only (deploy previews get the
# production values otherwise — point previews at a separate dev bucket).
#
# Local development: copy to .env.local, then `npm run dev:api` + `npm run dev`
# (or `npm run dev:netlify`). Without R2 values, dev:api uses a local file store.

# --- Required ---------------------------------------------------------------

# 32+ random bytes; derives verifier, session, sealing and fake-salt keys.
# Generate: openssl rand -base64 32
# Rotating it signs everyone out, disables email unlock until re-enabled and
# requires re-enrolling TOTP.
CK_SERVER_SECRET=

# Required to create vaults (typed on the Gate's "Create a vault" form).
# Leave empty to disable vault creation. Use a long random value.
VAULT_SETUP_CODE=

# Cloudflare R2 (S3 API). Use a token scoped to this bucket with
# Object Read & Write. The browser never talks to R2 directly, so the bucket
# needs no CORS rule.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: jurisdictional S3 API host, e.g. https://<account>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=

# --- Email (sign-in links, verification codes, security notices) -----------

# Brevo transactional email (free tier). MAIL_FROM must be a verified sender.
# Without BREVO_API_KEY, email features answer "not configured" in production;
# local dev (dev:api / netlify dev) prints the emails to the console instead.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Credentials Keep

# Links in emails use Netlify's built-in URL; override if needed.
# PUBLIC_SITE_URL=https://your-site.example

# --- Backups (server-side copies before overwrites) ---------------------------

# Minimum hours between backups (0 disables; a re-key always backs up first).
VAULT_BACKUP_INTERVAL_HOURS=8
# Days to keep backups (the newest three are always kept).
VAULT_BACKUP_RETENTION_DAYS=7
